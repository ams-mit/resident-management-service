# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/ams_resident_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Gateway & Security
GATEWAY_BASE_URL=http://localhost:8000
GATEWAY_JWT_PUBLIC_KEY=your_base64_encoded_rsa_public_key

# Service Authentication (Outbound Service JWT)
SERVICE_NAME=resident-management-service
SERVICE_JWT_PRIVATE_KEY=your_base64_or_pem_rsa_private_key
SERVICE_JWT_EXPIRES_IN=5m

# Client Timeouts
CLIENT_CONNECT_TIMEOUT_MS=3000
CLIENT_READ_TIMEOUT_MS=5000
